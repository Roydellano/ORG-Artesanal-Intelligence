# Copy to .env and add your OpenRouter API key. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TIMEOUT_SECONDS=40
OPENROUTER_REASONING=off
ELEVENLABS_API_KEY=
# Run python -m tools.setup_voice to create an agent and fill its ID.
ELEVENLABS_AGENT_ID=
# Optional: select a voice you have access to; otherwise ElevenLabs uses its default.
ELEVENLABS_VOICE_ID=
# Free endpoints: app-generated fictional demos only. Uploaded records require
# a model with data_collection=deny + zdr=true routing, or offline review.
